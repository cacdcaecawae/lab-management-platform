# 本机试用的环境变量。scripts/trial.ps1 第一次运行时复制成仓库根目录的 trial.env.local（不入库），
# 并把 __RANDOM__ 换成随机值。部署到服务器时不要用这个文件，另建 .env，见 README"生产式部署"。
DJANGO_SECRET_KEY=__RANDOM__
POSTGRES_PASSWORD=__RANDOM__
DJANGO_DEBUG=0
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
# 浏览器地址栏里的来源。改了 HTTP_PORT 要同步改这里，否则登录时提示 CSRF 校验失败
DJANGO_CSRF_TRUSTED_ORIGINS=http://localhost:8090,http://127.0.0.1:8090
# 本机只有 HTTP；服务器上配好 HTTPS 后改为 1
DJANGO_SECURE_COOKIES=0
HTTP_PORT=8090
