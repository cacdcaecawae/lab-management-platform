# 复制为 .env 后按需修改。.env 不入库。
DJANGO_SECRET_KEY=change-me-to-a-long-random-string
DJANGO_DEBUG=1
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
# 前端开发服务器地址（CSRF 可信来源，逗号分隔）
DJANGO_CSRF_TRUSTED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

POSTGRES_DB=lab
POSTGRES_USER=lab
POSTGRES_PASSWORD=lab-dev-password
DB_HOST=127.0.0.1
DB_PORT=5432
# 并行开发时每个工作区用不同的测试库名，避免互相覆盖
DB_TEST_NAME=

# 上传文件存放目录（原始数据、附件），默认 backend/var/data
DATA_ROOT=
# 单文件上传上限（字节），默认 2GB
MAX_UPLOAD_SIZE=2147483648

# 邮件不在这里配置：运维账号登录网页，在"系统管理 → 邮件"里填写 SMTP，保存后立即生效

# Login audit is opt-in; install the daily purge job before enabling in production.
LOGIN_AUDIT_ENABLED=0
